{
    "name"       : "joomlashack/osmap-tests",
    "description": "Test suite for OSMap",
    "type"       : "project",
    "license"    : "GPL-2.0-or-later",
    "authors"    : [
        {
            "name" : "Joomlashack",
            "email": "help@joomlashack.com"
        }
    ],
    "require-dev": {
        "codeception/codeception"                       : "^5.3",
        "codeception/module-asserts"                    : "^3.3",
        "phpstan/phpstan"                               : "^2.1",
        "squizlabs/php_codesniffer"                     : "^3.13",
        "phpcompatibility/php-compatibility"            : "^10.0@alpha",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Alledia\\OSMap\\"          : "../src/admin/library/Alledia/OSMap/",
            "Alledia\\Installer\\OSMap\\": "../src/admin/library/Installer/OSMap/",
            "Tests\\Support\\"          : "Support/",
            "Tests\\Unit\\"             : "Unit/"
        }
    },
    "config"     : {
        "platform"     : {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
